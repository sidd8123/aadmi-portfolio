rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public data — read by anyone
    match /projects/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /people/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /entities/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /campaigns/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
